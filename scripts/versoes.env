#
# Pilar "Versao": todas as versoes do ambiente ficam neste arquivo.
# Nada e instalado como "latest"; trocar uma versao e uma mudanca explicita,
# registrada no CHANGELOG.md.

# Cluster local
KUBERNETES_VERSION=v1.37.0
MINIKUBE_CPUS=4
MINIKUBE_MEMORIA_MB=8192
MINIKUBE_DISCO=30g

# Aplicacao (imagem construida a partir de app/Dockerfile)
PETCLINIC_COMMIT=500158f732419217507c7656904b8e6aa1bcc0d6
PETCLINIC_IMAGEM=petclinic:4.0.0-500158f

# Charts Helm da stack de observabilidade
CHART_KUBE_PROMETHEUS_STACK=93.4.1
CHART_LOKI=21.4.1
CHART_TEMPO=3.2.1
CHART_OTEL_COLLECTOR=0.180.0
CHART_POSTGRES_EXPORTER=8.3.0

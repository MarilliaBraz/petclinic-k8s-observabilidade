# Atividade 4 - Plataforma de Monitoramento e Observabilidade
# Grupo: Marillia Braz, Lucas Mendes e Pedro Henrique Feitosa
#
# Pilar "Ambiente": credenciais ficam fora do codigo e fora do Git.
# Copie para ambientes/local.env e troque os valores. Se o arquivo nao
# existir, scripts/subir.sh cria um com senhas aleatorias.

# Conta administrativa do PostgreSQL (so para criar banco e usuarios)
BANCO_ADMIN_USUARIO=postgres
BANCO_ADMIN_SENHA=troque-esta-senha

# Conta usada pelo PetClinic (dona do banco petclinic, sem superusuario)
BANCO_APP_SENHA=troque-esta-senha

# Conta de leitura de estatisticas usada pelo postgres-exporter (papel pg_monitor)
BANCO_MONITORAMENTO_SENHA=troque-esta-senha

# Acesso ao Grafana
GRAFANA_USUARIO=admin
GRAFANA_SENHA=troque-esta-senha
